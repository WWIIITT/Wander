# 漫迹 Wander — environment variables
# Copy to `.env` (do NOT commit `.env`)

# --- Server (server/api.ts) ---
# Enable AI suggestions (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# --- Client (Vite) ---
# Collaboration websocket URL (default is local y-websocket)
VITE_COLLAB_WS_URL=ws://localhost:1234

# Map tiles URL (some regions may need a different provider)
VITE_MAP_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
